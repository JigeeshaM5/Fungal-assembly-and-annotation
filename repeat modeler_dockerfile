FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    build-essential \
    perl \
    python3 \
    python3-pip \
    git \
    wget \
    ncbi-blast+ \
    hmmer \
    repeatmasker \
    repeatmodeler

# Install Snakemake
RUN pip3 install snakemake

WORKDIR /app
COPY . .
ENTRYPOINT ["snakemake"]
