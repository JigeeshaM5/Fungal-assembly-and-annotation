FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    perl \
    git \
    wget \
    unzip \
    build-essential \
    ncbi-blast+ \
    hmmer \
    emboss \
    funannotate \
    phobius

# Set environment variable
ENV FUNANNOTATE_DB=/bigdata/stajichlab/shared/lib/funannotate_db

# Install Snakemake
RUN pip3 install snakemake

WORKDIR /app
COPY . .
ENTRYPOINT ["snakemake"]
