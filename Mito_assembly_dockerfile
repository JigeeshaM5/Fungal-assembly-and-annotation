FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    git \
    wget \
    unzip \
    build-essential \
    ncbi-blast+ \
    minimap2

# Install Snakemake and Biopython
RUN pip3 install snakemake biopython

# Install NOVOPlasty
RUN wget https://github.com/ndierckx/NOVOPlasty/archive/refs/heads/master.zip && \
    unzip master.zip && \
    mv NOVOPlasty-master/NOVOPlasty.pl /usr/local/bin/NOVOPlasty.pl && \
    chmod +x /usr/local/bin/NOVOPlasty.pl

WORKDIR /app
COPY . .
ENTRYPOINT ["snakemake"]
