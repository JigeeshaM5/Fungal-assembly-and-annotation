FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    openjdk-11-jre \
    python3 \
    python3-pip \
    git \
    wget \
    unzip \
    bbmap \
    build-essential

# Install Snakemake
RUN pip3 install snakemake

# Add Trimmomatic
RUN mkdir -p /opt/trimmomatic && \
    wget -O /opt/trimmomatic/trimmomatic-0.39.jar https://github.com/timflutre/trimmomatic/raw/master/trimmomatic-0.39.jar && \
    mkdir -p /opt/trimmomatic/adapters && \
    wget -O /opt/trimmomatic/adapters/TruSeq3-PE.fa https://raw.githubusercontent.com/timflutre/trimmomatic/master/adapters/TruSeq3-PE.fa

WORKDIR /app
COPY . .
ENTRYPOINT ["snakemake"]
